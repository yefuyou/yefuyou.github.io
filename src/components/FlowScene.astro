---
import FlowWorker from './FlowWorker.astro';
interface Props { variant: 'sources' | 'extraction' | 'review' | 'memory' | 'lookup' | 'investigation' | 'grounding' | 'output'; }
const { variant } = Astro.props;
---
<svg class={'mechanism-scene scene-' + variant} viewBox="0 0 240 180" fill="none" aria-hidden="true" focusable="false">
  <g stroke="#262722" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {variant === 'sources' && <>
      <path d="m42 160 153 1m-126 8 38-1" opacity=".35" />
      <FlowWorker x={54} y={73} pose="carry" tilt={-9} />
      <path d="m114 37 54 4 2 77-59-2Z" fill="#eeece2" transform="rotate(8 140 80)" />
      <path d="m108 47 56-1 2 75-59 2Z" fill="#f7f5ed" transform="rotate(-4 140 85)" />
      <path d="m103 55 56 2-1 75-56-2Z" fill="#fcfaf3" />
      <path d="m116 72 28 1m-28 11 32 1m-32 12 22 1m-22 11 33 1" opacity=".5" />
      <path d="m101 93 10-2 8 4m-20 18 10-1 8-4" />
      <path d="m174 43 8-7m-1 20 12 1" opacity=".6" />
    </>}
    {variant === 'extraction' && <>
      <path d="m31 34 75 4-2 103-77-3Z" fill="#fcfaf3" transform="rotate(-6 65 85)" />
      <path d="m40 56 48 1m-48 12 36 2m-36 14 48 1m-49 24 31 1m-31 11 47 2" opacity=".45" />
      <path d="m41 83 43 1-1 14-43-1Z" fill="#f4d65b" stroke="none" opacity=".7" />
      <path d="M84 91c21-13 20-35 50-35" stroke-dasharray="3 5" />
      <FlowWorker x={118} y={74} pose="extract" />
      <path d="m183 47 40 6-4 37-40-6Z" fill="#f4d65b" />
      <path d="m191 62 22 3m-22 8 14 2" opacity=".6" />
      <path d="m93 158 109 1" opacity=".35" />
    </>}
    {variant === 'review' && <>
      <path d="m20 66 48-2 3 66-48 2Z" fill="#fcfaf3" />
      <path d="m31 82 26-1m-25 13 24-1m-23 15 20-1" opacity=".5" />
      <FlowWorker x={79} y={64} pose="stamp" />
      <path d="m131 104 76-4 5 48-81 4Z" fill="#fcfaf3" />
      <path d="m151 63 12-1 1 17-12 1Zm-7 17 27-1 2 11-30 1Z" fill="#e6bfc2" />
      <ellipse cx="175" cy="125" rx="18" ry="13" stroke="#9a6669" transform="rotate(-9 175 125)" />
      <path d="m167 125 6 5 12-12" stroke="#9a6669" />
      <path d="m24 154 189 1m-39-58 1-5m10 7 4-5" opacity=".4" />
    </>}
    {variant === 'memory' && <>
      <path d="m133 69 65-2 10 73-82 2Z" fill="#eeece2" />
      <path d="m129 88 72-3 3 57-80 2Z" fill="#fcfaf3" />
      <path d="m123 106 80-2 1 41-83 2Z" fill="#f7f5ed" />
      <path d="m136 63 42-3 6 45-46 3Z" fill="#f4d65b" transform="rotate(-12 158 82)" />
      <path d="m144 67 1 8m21-9 1 8m-22 9 26-2m-19 9 11-1" />
      <path d="m146 121 29-1 1 12-30 1Z" />
      <FlowWorker x={49} y={75} pose="file" />
      <path d="m35 159 175-1" opacity=".35" />
    </>}
    {variant === 'lookup' && <>
      <path d="m126 64 78-1 1 79-80 2Z" fill="#fcfaf3" />
      <path d="m126 104 78-2m-61 19 41-1m-40-39 40-1" />
      <path d="m145 29 36 2-1 47-39-1Z" fill="#f4d65b" transform="rotate(-8 161 52)" />
      <path d="m149 41 23 1m-23 9 16 1m-13 9 5 5 9-10" />
      <FlowWorker x={64} y={65} pose="lookup" />
      <path d="m40 151 174 1" opacity=".35" />
    </>}
    {variant === 'investigation' && <>
      <path d="M65 151c19 7 42-12 66-8 43 9 73-11 72-34-1-20-24-24-22-45" stroke-dasharray="3 6" />
      <path d="m155 30 39 3-2 48-40-2Zm39 62 31 3-3 41-33-2Z" fill="#fcfaf3" />
      <path d="m163 45 21 1m-21 11 18 1m16 50 17 2m-18 10 13 1" opacity=".5" />
      <path d="m10 94 29-5 5 39-30 6Z" fill="#f7f5ed" />
      <FlowWorker x={40} y={63} pose="scout" tilt={6} />
      <circle cx="125" cy="64" r="17" fill="#f4d65b" fill-opacity=".5" /><path d="m113 77-11 15m23-39 0 22m-10-10 20 0" />
      <path d="m200 149 23 0m-12-8 0 16" />
    </>}
    {variant === 'grounding' && <>
      <path d="m10 76 47-5 4 60-49 4Zm143 6 68 3-3 55-70-4Z" fill="#fcfaf3" />
      <path d="m20 91 29-3m-28 14 26-2m135-4 43 2m-44 14 39 2" opacity=".5" />
      <path d="m21 109 26-2m114 7 39 2" stroke="#c6ac3c" stroke-width="6" opacity=".55" />
      <FlowWorker x={75} y={62} pose="verify" />
      <circle cx="162" cy="66" r="20" fill="#f7f5ed" fill-opacity=".6" /><path d="m146 81-13 14m22-29 6 6 13-16" />
      <path d="m26 154 192-1" opacity=".35" />
    </>}
    {variant === 'output' && <>
      <FlowWorker x={18} y={65} pose="assemble" />
      <path d="m100 76 37-4 3 66-41 4Z" fill="#fcfaf3" transform="rotate(-6 120 108)" />
      <path d="m145 72 39 3-2 66-41-2Z" fill="#fcfaf3" />
      <path d="m190 77 37 1-2 62-39 1Z" fill="#f7f5ed" stroke-dasharray="3 4" />
      <path d="m110 95 20-2m-19 12 18-2m-18 15 5 4 13-13m22-19 22 2m-22 11 20 2m-21 10 17 2" />
      <path d="M200 101c0-9 15-8 14 0-1 5-9 5-8 11m0 6h0" />
      <path d="m13 155 216-1" opacity=".35" />
    </>}
  </g>
</svg>
