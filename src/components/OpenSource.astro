---
import { openSourceTopics } from '../data/open-source';
import { localize, profile, type Locale } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = (en: string, zh: string) => localize(lang,en,zh);
---
<div class="upstream-topics">
  {openSourceTopics.map(topic => <article class={'upstream-topic topic-' + topic.id} aria-labelledby={'upstream-' + topic.id}>
    <div class="topic-heading"><p>{topic.area[lang]}</p><h3 id={'upstream-' + topic.id}>{topic.name}</h3><span class="merged-state">✓ Merged</span></div>
    <div class="topic-content"><h4>{topic[lang].headline}</h4><p>{topic[lang].problem}</p><p>{topic[lang].design}</p>
      {'chain' in topic && <ol class="metric-path" aria-label={t('Latency data path','延迟数据链路')}>{topic.chain[lang].map(step => <li>{step}</li>)}</ol>}
      {'metrics' in topic && <dl class="metric-definitions">{topic.metrics.map(metric => <div><dt>{metric.name}</dt><dd>{metric[lang]}</dd></div>)}</dl>}
      <p>{topic[lang].result}</p>
      <ul class="upstream-links">{topic.prs.map(pr => <li><a href={pr.url} target="_blank" rel="noopener noreferrer" aria-label={`${topic.name} #${pr.number} — ${pr[lang]} — Merged`}><span>#{pr.number}</span>{pr[lang]}<Arrow diagonal /></a></li>)}</ul>
    </div>
  </article>)}
</div>
<div class="upstream-footer"><p>{t('Selected merged contributions · verified 28 Oct 2026','精选已合并贡献 · 核验于 2026-10-28')}</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">{t('More on GitHub','更多 GitHub 贡献')}<Arrow diagonal /></a></div>
<style>
  .upstream-topics { display: grid; grid-template-columns: 1fr 1fr; column-gap: 68px; }
  .upstream-topic { border-top: 1px solid var(--line); padding-top: 27px; }
  .topic-heading { position: relative; padding-right: 72px; }
  .topic-heading > p { font-size: 12px; color: var(--muted); margin-bottom: 9px; }
  .topic-heading h3 { font-size: 28px; line-height: 1.3; letter-spacing: -.8px; }
  .merged-state { position: absolute; right: 0; top: 3px; font-size: 11px; color: #4b6140; }
  .topic-content h4 { font-size: 22px; line-height: 1.5; letter-spacing: -.5px; white-space: pre-line; margin: 24px 0 15px; font-weight: 600; }
  .topic-content > p { font-size: 14px; line-height: 1.85; color: var(--muted); margin-top: 14px; }
  .metric-path { display: flex; flex-wrap: wrap; list-style: none; padding: 15px 0; gap: 8px; margin-top: 20px; border-block: 1px solid var(--line); }
  .metric-path li { font-size: 11px; line-height: 1.8; }
  .metric-path li + li::before { content: '→'; margin-right: 8px; color: var(--muted); }
  .metric-definitions { margin: 16px 0; }
  .metric-definitions > div { display: grid; grid-template-columns: 92px 1fr; gap: 12px; margin-block: 8px; }
  .metric-definitions dt { font-size: 12px; font-weight: 650; }
  .metric-definitions dd { font-size: 12px; line-height: 1.75; color: var(--muted); margin: 0; }
  .upstream-links { display: flex; flex-wrap: wrap; list-style: none; padding: 0; gap: 14px 25px; margin-top: 26px; }
  .upstream-links a { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; border-bottom: 1px solid var(--line); padding-bottom: 5px; }
  .upstream-links a > span { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .upstream-links :global(.arrow-icon) { width: 13px; height: 13px; }
  .upstream-links a:hover { border-color: var(--ink); }
  .topic-qwen { grid-column: 1 / -1; display: grid; grid-template-columns: .8fr 1.25fr; gap: 70px; margin-top: 45px; }
  .topic-qwen .topic-content h4 { margin-top: 0; }
  .upstream-footer { display: flex; justify-content: space-between; align-items: center; gap: 25px; margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
  .upstream-footer a { font-size: 12px; color: var(--ink); }
  @media (max-width:800px) {
    .upstream-topics { grid-template-columns: 1fr; gap: 38px; }
    .topic-qwen { grid-template-columns: 1fr; gap: 23px; margin-top: 0; }
    .topic-heading h3 { font-size: 26px; }
    .topic-content h4 { font-size: 21px; }
  }
  @media (max-width:480px) {
    .topic-heading h3 { font-size: 23px; }
    .topic-content h4 { font-size: 20px; }
    .upstream-footer { align-items: flex-start; flex-direction: column; gap: 13px; }
  }
</style>
